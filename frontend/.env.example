# Browser requests use the same-origin Vite proxy so session and CSRF cookies work.
VITE_API_URL=/api

# Direct Backend address displayed in Agent setup instructions.
VITE_AGENT_API_URL=http://localhost:3000

# Vite development proxy target. Set this to the host address reachable by this PC.
INFRAVISION_BACKEND_URL=http://localhost:3000
